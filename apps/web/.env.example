# Copy to apps/web/.env.local and fill in. .env.local is gitignored.
# Razorpay Test Mode credentials (dashboard.razorpay.com -> Settings -> API Keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-side secret used to sign Commerce Envelopes and session tokens.
ENVELOPE_SIGNING_SECRET=dev-secret-change-me

# Webhook secret for Razorpay webhook signature verification (optional for the
# standard Checkout flow; required only for webhook delivery via a public tunnel).
RAZORPAY_WEBHOOK_SECRET=

# Optional LLM enrichment layer (soft preferences + explanations only).
# Deterministic parsing and policy remain authoritative for hard constraints
# and money decisions. Without a key the app runs fully deterministically.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-3-mini
LLM_TIMEOUT_MS=5000

NEXT_PUBLIC_APP_URL=http://localhost:3000