# Razorpay test-mode credentials (dashboard.razorpay.com -> Settings -> API Keys)
# Leave empty to run against the clearly-labelled MockRazorpayAdapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-side secret used to sign Commerce Envelopes and session tokens.
ENVELOPE_SIGNING_SECRET=dev-secret-change-me

# OpenAI-compatible LLM endpoint (Grok: https://api.x.ai/v1, OpenCode GO: your gateway URL)
# Optional enrichment only: soft preferences + explanations. Deterministic parsing and
# policy remain authoritative for hard constraints and money decisions.
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-3-mini
LLM_TIMEOUT_MS=5000

# Optional: webhook secret for Razorpay webhook signature verification.
RAZORPAY_WEBHOOK_SECRET=

# x402/Solana machine rail — premium fit-scoring resource.
#
# Mode: "mock" (default, safe, no real funds) or "devnet" (Solana Devnet USDC).
# When devnet, a funded payer keypair and payee address are required.
# Explicitly set to "mock" or "devnet" — any other value will throw at startup.
X402_MODE=mock

# Facilitator URL (public devnet: https://x402.org/facilitator)
X402_FACILITATOR_URL=https://x402.org/facilitator

# Solana Devnet RPC endpoint (optional; SDK default is fine for most cases)
X402_SOLANA_RPC_URL=

# Payee public address (RunVista receives the payment)
X402_PAYEE_PUBLIC_KEY=PLACEHOLDER_PAYEE_PUBLIC_KEY

# Path to the payer keypair JSON file (Solana CLI format: [byte, byte, ...]).
# This file MUST:
#   - contain a dedicated Devnet-only burner keypair
#   - be outside the repository or explicitly gitignored
#   - have restrictive filesystem permissions (chmod 600)
#   - never be read by client/browser code
#   - never be logged, serialized into errors, or included in tests
X402_PAYER_KEYPAIR_PATH=/absolute/path/to/devnet-burner-keypair.json

# USDC mint on Solana Devnet (default: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU)
X402_DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Payment amount in minor units (6 decimals for USDC). 10000 = 0.01 USDC.
X402_AMOUNT_MINOR=10000

# Legacy demo mock config (used when X402_MODE=mock)
X402_DEMO_PAYEE_WALLET=demo_payee_RunVista_mock
X402_DEMO_AGENT_WALLET=demo_agent_wallet_mock
X402_DEMO_USDC_MINT=usdc_devnet_mock_mint

# Base URL used to build Razorpay Checkout redirects and x402 server-side transport
# (e.g. http://localhost:3000). Required for Devnet mode to avoid fetch("/api/...").
NEXT_PUBLIC_APP_URL=http://localhost:3000
