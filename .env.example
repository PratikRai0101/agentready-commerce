# Razorpay test-mode credentials (dashboard.razorpay.com -> Settings -> API Keys)
# Leave empty to run against the clearly-labelled MockRazorpayAdapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server-side secret used to sign Commerce Envelopes and session tokens.
ENVELOPE_SIGNING_SECRET=dev-secret-change-me

# OpenAI-compatible LLM endpoint (Grok: https://api.x.ai/v1, OpenCode GO: your gateway URL)
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-3-mini

# Optional: webhook secret for Razorpay webhook signature verification.
RAZORPAY_WEBHOOK_SECRET=

# Base URL used to build Razorpay Checkout redirects (e.g. http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000